												</node>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="947.716" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<attribute id="Value" type="float" value="8" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="947.716" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<attribute id="Value" type="float" value="1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="Channel" />
												<node id="Channel" />
												<node id="Channel" />
												<node id="Channel" />
											</children>
										</node>
									</children>
								</node>

								<!--Start Dialog Tutorial Edits-->

								<!--First shot of morning after scene.-->
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLCameraDoF" />
									<!--Camera depth of field controls what parts of the scene are 'in focus,' i.e. it emulates real life camera depth of field by blurring parts of the scene, at different distances from the camera.-->
									<attribute id="ID" type="guid" value="f3ea4726-9421-4701-8ff0-08a2efb0e00c" />
									<attribute id="StartTime" type="float" value="935.216" />
									<attribute id="EndTime" type="float" value="947.716" />
									<attribute id="PhaseIndex" type="int64" value="96" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<!--The camera the DoF field effect will apply to.-->
										<node id="Actor">
											<attribute id="UUID" type="guid" value="4655c9c8-c09a-4c4a-b95d-111cf5c4379f" />
										</node>
										<!--There are seven channels for TLCameraDoF, but I'm still trying to figure out what most of them do. I am pretty sure about what the first two channels do, though!-->
										<node id="Channels">
											<children>
												<!--The first channel is the distance from the camera that the depth of field effect will center on. How much of the scene before and after this center will actually *be* in focus is determined by the other channels, though, especially the second channel.-->
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<!--Like TLTransform, the elements in these channels can be transitioned between. It's used in this scene to create a rack focus effect, where the camera changes focus in the middle of a shot.-->
																<node id="Key">
																	<!--The start time of the focus transition.-->
																	<attribute id="Time" type="float" value="935.216" />
																	<!--Transition/tweening type, similar to TLTransform!-->
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--The distance from the camera that'll be in focus. Or, more specifically, the center of what's in focus.-->
																	<attribute id="Value" type="float" value="10" />
																</node>
																<node id="Key">
																	<!--The end time of the focus transition.-->
																	<attribute id="Time" type="float" value="938.526" />
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--For this example, I pulled the focus closer to the camera. This means your character will no longer be in focus, unlike the original shot, because your character is much further away from the camera. A different kind of 'Fuck it, nothing!' effect from TLShowVisual.-->					
																	<attribute id="Value" type="float" value="5" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The second channel controls the actual extent of the depth of field effect. Bigger numbers mean a bigger depth of field, and more of the scene will be in focus. Smaller numbers create shallow depth of field effects.-->
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="935.216" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--In the original file, both values here were the same, and only the interpolation/transition type changed.-->
																	<attribute id="Value" type="float" value="12" />
																</node>
																<node id="Key">
																	<attribute id="Time" type="float" value="938.526" />
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--For this, though, I changed the second value to make the depth of field much smaller, meaning that less and less of the scene is able to be in focus over time.-->
																	<attribute id="Value" type="float" value="1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--I'm still trying to figure out the other channels, though. Not super sure what this one does.-->
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="935.216" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<attribute id="Value" type="float" value="1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The following 3 channels (and maybe the 4th one too?) seem to be able to create different 'pockets' of things in focus, that seem to be related to the distance set in the first channel. I haven't figured out consistent ways of editing them, though. But the following TLCameraDoF effect has an attempt!-->
												<node id="Channel" />
												<node id="Channel" />
												<node id="Channel" />
												<node id="Channel" />
											</children>
										</node>
									</children>
								</node>

								<!--The shot after your character wakes up, and it shows a closeup of their face. I made some tweaks here, just to experiment.-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLCameraDoF" />
									<attribute id="ID" type="guid" value="e77caf7b-141d-4fb7-85d5-c63a1eb39231" />
									<attribute id="StartTime" type="float" value="935.216" />
									<attribute id="EndTime" type="float" value="947.716" />
									<attribute id="PhaseIndex" type="int64" value="96" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="dbabb61c-d79a-4a43-9d2e-b229ef58486a" />
										</node>
										<node id="Channels">
											<children>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="943.126" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<attribute id="Value" type="float" value="1.5" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="943.126" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--I've set the DoF to 0 here. Without adding anything to Channel 5, this would make the entire scene blurry.-->
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="Channel" />
												<node id="Channel" />													
												<!--Changing this channel (Channel 5) seemed to create a center of focus on the player's face, at least for Body 2...-->
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="943.126" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--Changing this value also changed how much of his body was in focus, so I think these channels are creating independent depth of field effects? Hm.-->
																	<attribute id="Value" type="float" value="0.4" />
																</node>
															</children>
														</node>
													</children>
												</node>																							
												<node id="Channel" />																			
												<node id="Channel" />	
											</children>
										</node>
									</children>
								</node>

								<!--End Dialog Tutorial Edits-->

