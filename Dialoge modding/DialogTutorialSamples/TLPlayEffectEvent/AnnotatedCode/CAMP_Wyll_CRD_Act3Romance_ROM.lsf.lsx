											<attribute id="UUID" type="guid" value="728f500d-f7f3-4673-9d0b-c62dab88fe97" />
										</node>
									</children>
								</node>

								<!--Start Dialog Tutorial Edits-->

								<node id="EffectComponent">
									<!--Will allow you to show the effect! Needs to accompany the TLPlayEffectEvent effect component.-->
									<attribute id="Type" type="LSString" value="TLShowVisual" />
									<attribute id="ID" type="guid" value="8c3ecf24-6acf-4c0d-b4b1-406d799d1963" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<!--The VFX actor ID, which should be included in the TimelineActorData section. This one links to the aurora borealis VFX from Gale's Act 2 Romance Scene, which I yoinked for this scene. Should match the actor for TLPlayEffectEvent!-->
											<attribute id="UUID" type="guid" value="4dc68307-a448-4f78-a082-c4c0c0b93a0a" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<!--You can specify start times partway through the dialog or cinematic. This doesn't, though, because it's set to play at the start of the scene, and the first line of dialog in this scene is at the very start of the timeline!-->
													<attribute id="InterpolationType" type="uint8" value="3" />
												</node>
											</children>
										</node>										
									</children>
								</node>
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLPlayEffectEvent" />
									<attribute id="ID" type="guid" value="46facec8-f0c4-48fe-80d2-7808c3a0057b" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<!--Again, the VFX actor ID. Should match the actor from the TLShowVisual effect component!-->										
											<attribute id="UUID" type="guid" value="4dc68307-a448-4f78-a082-c4c0c0b93a0a" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<attribute id="InterpolationType" type="uint8" value="3" />
												</node>
											</children>
										</node>										
									</children>
								</node>

								<!--You will most likely need a TLTransform node to accompany your VFX and get them to play where you'd like them! You can look at my examples on TLTransform for more information on this effect component.-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="4fadf1c0-6288-4c75-9b0f-eef25a91b25b" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<!--Allows the TLTransform changes to continue past the end of the dialog node/cinematic!-->
									<attribute id="Continuous" type="bool" value="True" />
									<children>
										<node id="Actor">
											<!--Again, should match the Actor ID of your VFX.-->
											<attribute id="UUID" type="guid" value="4dc68307-a448-4f78-a082-c4c0c0b93a0a" />
										</node>
										<node id="TransformChannels">
											<children>
												<!--X position of your VFX. All of these are zero here, because I've bound the VFX to the center of the scene, but you might need to place your VFX somewhere else!-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--Y position of your VFX.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--Z position of your VFX.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The rotation of your VFX.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="fvec4" value="0 0 0 1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The scale of your VFX.-->
												<node id="TransformChannel" />
												<!--Can be used to bind your VFX to a specific other actor! You can look at the VFX for Gale's hologram ghost in his death scene for an example; the VFX for the projection's eye glow is bound to his eyes. Which is a bit of horror movie way of phrasing that but it's the best example I can think of...-->
												<node id="TransformChannel" />
											</children>
										</node>
									</children>
								</node>	

								<!--An additional set of VFX, this time the stars from Gale's Act 2 Romance scene.-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLShowVisual" />
									<attribute id="ID" type="guid" value="bbe2833e-0711-4e17-ab13-8788bd97c5a7" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="3bdf5095-b767-4df3-bfa6-44d49264309b" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<attribute id="InterpolationType" type="uint8" value="3" />
												</node>
											</children>
										</node>										
									</children>
								</node>
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLPlayEffectEvent" />
									<attribute id="ID" type="guid" value="d3ff1836-7692-4861-95ff-e08129f7f334" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="3bdf5095-b767-4df3-bfa6-44d49264309b" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<attribute id="InterpolationType" type="uint8" value="3" />
												</node>
											</children>
										</node>										
									</children>
								</node>

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="8178f505-b136-4774-a8f9-9241470d1d33" />
									<attribute id="EndTime" type="float" value="10.55" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<attribute id="Continuous" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="3bdf5095-b767-4df3-bfa6-44d49264309b" />
										</node>
										<node id="TransformChannels">
											<children>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="fvec4" value="0 0 0 1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel" />
												<node id="TransformChannel" />
											</children>
										</node>
									</children>
								</node>																

								<!--End Dialog Tutorial Edits-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLAttitudeEvent" />
									<attribute id="ID" type="guid" value="de1169f4-482a-412a-1204-0dd2d428112d" />
