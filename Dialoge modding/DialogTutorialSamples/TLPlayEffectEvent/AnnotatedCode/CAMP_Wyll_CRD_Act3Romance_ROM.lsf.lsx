								<!--Start Dialog Tutorial Edits-->

								<!--Make sure you place your VFX in the TimelineActorData section, so you can reference them in your TLPlayEffectEvent effect components!-->

								<node id="Object" key="MapKey">
									<!--The Actor ID you should use to reference the VFX. Referencing the VFX directly won't work!-->
									<attribute id="MapKey" type="guid" value="4dc68307-a448-4f78-a082-c4c0c0b93a0a" />
									<children>
										<node id="Value">
											<!--Make sure the ActorTypeID is effect.-->
											<attribute id="ActorTypeId" type="FixedString" value="effect" />
											<!--This is usually 4 for VFX!-->
											<attribute id="ActorType" type="uint8" value="4" />
											<attribute id="DefaultStepOutDelay" type="float" value="0.39495835" />
											<!--The UUID for the VFX itself! This one is for the Aurora Borealis from Gale's Act 2 Romance Scene.-->
											<attribute id="ResourceId" type="guid" value="b946b1ba-25a5-b8c9-488c-36d414f7e7b3" />
											<children>
												<node id="CompiledNodeSnapshots">
													<children>
														<node id="ComponentMap" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
								<node id="Object" key="MapKey">
									<attribute id="MapKey" type="guid" value="3bdf5095-b767-4df3-bfa6-44d49264309b" />
									<children>
										<node id="Value">
											<attribute id="ActorTypeId" type="FixedString" value="effect" />
											<attribute id="ActorType" type="uint8" value="4" />
											<attribute id="DefaultStepOutDelay" type="float" value="0.39495835" />
											<!--...And this is the UUID for the stars VFX!-->
											<attribute id="ResourceId" type="guid" value="c349b47c-dac5-bb67-c873-7cfb35a18526" />
											<children>
												<node id="CompiledNodeSnapshots">
													<children>
														<node id="ComponentMap" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>								

