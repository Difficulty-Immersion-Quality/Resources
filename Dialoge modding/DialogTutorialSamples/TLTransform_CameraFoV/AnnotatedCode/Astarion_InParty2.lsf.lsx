								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLVoice" />
									<attribute id="ID" type="guid" value="e9d023e6-7064-4d38-ac33-e7bc7945f099" />
									<attribute id="StartTime" type="float" value="195.37129" />
									<attribute id="EndTime" type="float" value="200.37129" />
									<attribute id="PhaseIndex" type="int64" value="34" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<attribute id="DialogNodeId" type="guid" value="e4ca6217-ec1b-4645-9420-d098f682f3b9" />
									<attribute id="ReferenceId" type="guid" value="069b5275-7a6f-49a7-9060-bad2bda9a6da" />
									<attribute id="PerformanceFade" type="double" value="0" />
									<attribute id="FadeIn" type="double" value="0" />
									<attribute id="FadeOut" type="double" value="0" />
									<children>
										<node id="Actor">
