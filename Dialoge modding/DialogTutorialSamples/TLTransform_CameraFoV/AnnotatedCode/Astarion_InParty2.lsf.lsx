								</node>

								<!--Start Dialog Tutorial Edits-->
								
								<!--Edits are for the line 'Ah, my favourite travelling companion.'-->

                                <!--TLTransform-->

									<!--Allows you to reposition, rotate, and scale cameras, characters, and items within a scene.-->
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="8e1e3847-1620-4318-bb6f-cdb9117e0c94" />
									<attribute id="StartTime" type="float" value="195.37129" />
									<attribute id="EndTime" type="float" value="200.37129" />
									<attribute id="PhaseIndex" type="int64" value="34" />
									<!--Sometimes there will be an attribute here:

									<attribute id="Continuous" type="bool" value="True" />

									This controls whether the TLTransform position changes continue past the end of the dialog/cinematic node. In this case, it doesn't, but still important to note.
									-->
									<children>
										<node id="Actor">
											<!--The actor being transformed! In this case, it's the camera used for this shot.-->
											<attribute id="UUID" type="guid" value="56546948-fa49-4bce-92c7-5707e8d19c84" />
										</node>
										<!--There are 5 channels for TLTransform!
										The first and third channels control the distance from the actor's default position along the X and Z axes respectively. The second channel controls the actor's distance from the ground, i.e. its position on the Y axis in the world.
										
										The fourth channel deals with the rotation of the actor.
										
										And the fifth channel will let you bind the actor's positioning to a specific other actor, allowing it to move with that actor! You can look at the TLTransform effect components in Gale's death dialog for an example. The VFX for his ghost projection's eyes are bound to the the eyes of the projection.-->
										<node id="TransformChannels">
											<children>
												<!--TransformChannel 1 controls the distance from the actor's default position along the X axis.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>          
																<node id="Key">
																	<!--The time you want your positioning to start.-->
																	<attribute id="Time" type="float" value="196.37129" />
																	<!--This controls the type of transition/tweening. InterpolationType 5 for TLTransform seems to be a quicker transition from InterpolationType 2 and 0. InterpolationType 3 seems to be no tweening; it'll just jump between them.-->																	
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--The start position of the actor..-->
																	<attribute id="Value" type="float" value="-0.615434" />
																</node>
																<!--If there's another time listed in your TLTransform effect component, the game will transition between them automatically!-->         
																<node id="Key">
																	<!--The end time of the position transition.-->
																	<attribute id="Time" type="float" value="199.37129" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--The end position of the actor.-->
																	<attribute id="Value" type="float" value="0.978434" />
																</node>             
															</children>
														</node>
													</children>
												</node>
												<!--The how far the actor is from the ground, i.e. its position on the Y axis.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<!--When there's only one position listed, that will be the position for the duration of the TLTransform effect component!-->																	
																	<attribute id="Time" type="float" value="163.10858" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<attribute id="Value" type="float" value="1.712441" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The distance from the actor's default position along the Z axis.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="195.37129" />
																	<attribute id="InterpolationType" type="uint8" value="0" />
																	<attribute id="Value" type="float" value="0.017464" />
																</node>
																<!--Again, will transition between positions along the Z axis.-->
																<node id="Key">
																	<attribute id="Time" type="float" value="198.37129" />
																	<!--InterpolationTypes do not have to be the same for each position!-->
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<attribute id="Value" type="float" value="3" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--The rotation of the actor, in RotationQuat/Quaternation. The Adding and Positioning Items in the World guide on the BG3 Community Modding Wiki has a guide on RotationQuat/quaternation, which will help you calculate this!-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">						
																	<!--If this is the only position listed, it'll still be the only position used by the TLTransform node, even if it's set to start partway through it.-->
																	<attribute id="Time" type="float" value="197.87129" />
																	<attribute id="InterpolationType" type="uint8" value="5" />
																	<!--The rotation position, in Rotation Quaternation.-->
																	<attribute id="Value" type="fvec4" value="0 0.9271839 0 0.3746066" />
																</node>                                                               
															</children>
														</node>
													</children>
												</node>
												<!--The scale of the actor. This is a bit harder to demonstrate for cameras, so I have an example editing the scale of the player character right after this..-->
												<node id="TransformChannel" />
												<!--Allows you to bind the actor's position to a specific other actor. When they move, so does this actor. This makes it really hard to see the other changes I made, though! So I've added it to a different dialog node later in the file.-->
												<node id="TransformChannel" />
											</children>
										</node>
									</children>
								</node>		

								<!--Changes the scale of the player!-->
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="f0229b88-1b71-4bad-9bdf-0952d7553390" />
									<attribute id="StartTime" type="float" value="195.37129" />
									<attribute id="EndTime" type="float" value="200.37129" />
									<attribute id="PhaseIndex" type="int64" value="34" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="6c70c2df-ab95-d5c1-0db5-c863be615f73" />
										</node>
										<node id="TransformChannels">
											<children>
												<node id="TransformChannel" />
												<node id="TransformChannel" />
												<node id="TransformChannel" />
												<node id="TransformChannel" />
												<!--Again, this channel controls the scale of the actor.-->
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="195.37129" />
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--This is the default value for scale. The model size will be multiplied by this value, so if you want to halve the scale of the actor's model, you'd put 0.5, and if you want to double it, you'd put 2, etc.-->
																	<attribute id="Value" type="float" value="1" />
																</node>				
																<!--Actor scale can also be tweened!-->											
																<node id="Key">
																	<attribute id="Time" type="float" value="198.37129" />
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--Tiny.-->
																	<attribute id="Value" type="float" value="0.3" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel" />
											</children>
										</node>
									</children>
								</node>	

								<!--FoV Change-->


								<node id="EffectComponent">
									<!--Allows you to change the camera Field of View. Can be used to emulate different camera focal lengths!-->
									<attribute id="Type" type="LSString" value="TLCameraFoV" />
									<attribute id="ID" type="guid" value="fda409b9-c619-4c64-8215-04f8724cf6ae" />
									<attribute id="StartTime" type="float" value="195.37129" />
									<attribute id="EndTime" type="float" value="200.37129" />
									<attribute id="PhaseIndex" type="int64" value="34" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<!--The camera that'll be affected by the Field of View changes.-->
										<node id="Actor">
											<attribute id="UUID" type="guid" value="56546948-fa49-4bce-92c7-5707e8d19c84" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<!--The start time for your FoV change.-->
													<attribute id="Time" type="float" value="195.37129" />
													<!--Controls transitions/tweening between FoV states, like TLTransform.-->
													<attribute id="InterpolationType" type="uint8" value="0" />
													<!--This is a narrower FoV, and one that's often used in dialog for this game.-->
													<attribute id="FoV" type="float" value="24" />
												</node>
												<node id="Key">
													<!--The time you'd like the FoV to change.-->
													<attribute id="Time" type="float" value="198.37129" />
													<attribute id="InterpolationType" type="uint8" value="5" />
													<!--This is an extreme wide angle FoV!-->
													<attribute id="FoV" type="float" value="120" />
												</node>												
											</children>
										</node>
									</children>
								</node>

								<!--I've also changed the FoV of the second shot in the dialog, the one where the camera looks at the player.-->							
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLCameraFoV" />
									<attribute id="ID" type="guid" value="c0bea54d-09ce-4513-a2a7-d3ca43b8f978" />
									<attribute id="StartTime" type="float" value="195.37129" />
									<attribute id="EndTime" type="float" value="200.37129" />
									<attribute id="PhaseIndex" type="int64" value="34" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="7a4e6cc7-9a5b-4507-8bc1-0a33fc17ad1f" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
													<attribute id="Time" type="float" value="195.37129" />
													<attribute id="InterpolationType" type="uint8" value="2" />
													<attribute id="FoV" type="float" value="120" />
												</node>
											</children>
										</node>
									</children>
								</node>

								<!--End Dialog Tutorial Edits-->

