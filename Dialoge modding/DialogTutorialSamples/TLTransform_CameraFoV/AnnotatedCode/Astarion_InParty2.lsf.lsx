								<!--Start Dialog Tutorial Edits-->
								
								<!--Edits are for the line 'Hello, my dear.'-->

                                <!--TLTransform-->

								<!--This is to demonstrate the 5th TLTransform channel!-->
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="4593e196-fa54-411b-b51c-4a905f00fec8" />
									<attribute id="StartTime" type="float" value="230.38129" />
									<attribute id="EndTime" type="float" value="233.88129" />
									<attribute id="PhaseIndex" type="int64" value="40" />
									<children>
										<node id="Actor">
											<!--Again, this actor is the camera used for this shot.-->
											<attribute id="UUID" type="guid" value="35a4a6a5-d964-497c-b6c7-675e2f58c7c5" />
										</node>
										<!--Usually, when using the 5th transform channel, first 4 transform channels are set up in the way this one is, with each value set to 0.-->
										<node id="TransformChannels">
											<children>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="230.38129" />
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="230.38129" />
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="230.38129" />
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="float" value="0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="230.38129" />
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<attribute id="Value" type="fvec4" value="0 0 0 1" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="TransformChannel" />
												<node id="TransformChannel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="Time" type="float" value="230.38129" />
																	<attribute id="InterpolationType" type="uint8" value="3" />
																	<children>
																		<node id="Value">
																			<children>
																				<node id="frameOfReference">
																					<!--The actor this channel is bound to. In this case, the player.-->
																					<attribute id="targetId" type="guid" value="6c70c2df-ab95-d5c1-0db5-c863be615f73" />
																					<!--The bone this channel is bound to. In this case, the player's head. This can be left blank, though.-->
																					<attribute id="targetBone" type="FixedString" value="Head_M" />
																					<!--If this is true, it'll hold the channel in the inital position it was placed, and won't move alongside the actor it's bound to. Its initial position will still be based on that actor, though.-->
																					<attribute id="OneFrameOnly" type="bool" value="False" />
																					<!--Not sure whether this means it keeps its own scale or if it keeps the scale of the actor it's bound to, honestly. Will have to do more experimenting.-->
																					<attribute id="KeepScale" type="bool" value="True" />
																				</node>
																			</children>
																		</node>
																	</children>
																</node>
															</children>
														</node>
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>		

								<!--Changes the scale of the player, to give you a better idea of how the camera's bound to the actor.-->
								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLTransform" />
									<attribute id="ID" type="guid" value="f0229b88-1b71-4bad-9bdf-0952d7553390" />
									<attribute id="StartTime" type="float" value="230.38129" />
