								</node>

								<!--Start Dialog Tutorial Edits-->

								<!--Ketheric's Bedroom - TLSwitchLocationEvent tutorial (puts the part of Gale's Act 2 romance scene if you ask to be with the real Gale in Ketheric Thorm's bedroom.)-->

								<node id="EffectComponent">
									<!--TLSwitchLocationEvent allows you to take the characters to a different location within a level. This is done by referencing a specific SceneTrigger within that level. You can use an existing scene trigger, or you can make your own!-->
									<attribute id="Type" type="LSString" value="TLSwitchLocationEvent" />
									<attribute id="ID" type="guid" value="65c96ee3-3923-48cc-8557-d334b5ffbbc7" />
									<attribute id="StartTime" type="float" value="788.328" />
									<attribute id="EndTime" type="float" value="835.588" />
									<attribute id="PhaseIndex" type="int64" value="47" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Keys">
											<children>
												<node id="Key">
													<!--Put the time you'd like to switch locations here.-->
													<attribute id="Time" type="float" value="788.328" />
													<attribute id="InterpolationType" type="uint8" value="3" />
													<!--Put a scene trigger for the location you'd like to switch to here. This scene trigger will need to be in the same level as your scene. Also, make sure this UUID is placed in the AdditionalLocations section later in the file!-->
													<attribute id="SwitchLocationEventID" type="guid" value="f1987cb4-9102-475e-aa6e-0b6d97871cbf" />
												</node>
											</children>
										</node>
									</children>
								</node>

								<!--Atmosphere and lighting tutorial. Changes the lighting in this section of the scene to match the rest of Gale's Act 2 romance scene, because switching locations reset it.-->

								<node id="EffectComponent">
									<!--Allows you to set atmosphere and lighting presets for specific scenes.-->
									<attribute id="Type" type="LSString" value="TLAtmosphereAndLighting" />
									<attribute id="ID" type="guid" value="ae584f96-f827-44b5-92bf-26c3b1bde9b2" />
									<attribute id="StartTime" type="float" value="788.328" />
									<attribute id="EndTime" type="float" value="835.588" />
									<attribute id="PhaseIndex" type="int64" value="47" />
									<!--The TLAtmosphereAndLighting effect component doesn't seem to need an actor! Which makes sense, since it applies to the whole scene!-->
									<children>
										<!--Instead, it has two channels: Atmosphere (the first channel) and Lighting (the second channel). Atmosphere presets seem to be able to handle things like wind speed, color correction, camera effects and post processing, and scene VFX. Lighting is self explanatory!-->
										<node id="Channels">
											<children>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<!--The time you want the Atmosphere preset to begin. You can have multiple transitions in the same effect component!-->
																	<attribute id="Time" type="float" value="788.328" />
																	<!--Like TLTransform, this controls the transitions/tweening between different Atmosphere settings.-->
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--This will refer to an AtmosphereBank resource. In this case, it's referring to the ATM_WLD_CIN_Dreamscene_NightWithGale Atmosphere resource!-->
																	<attribute id="id" type="guid" value="490fe912-d8c3-d67d-4765-c6398d7e5f0d" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<node id="Channel">
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<!--Same as above, but for lighting!-->
																	<attribute id="Time" type="float" value="788.328" />
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--This will refer to a LightingBank resource, instead of an AtmosphereBank resource! In this case, it's refering to the LTN_Default_EV11_Dusk_GaleLastNight_A LightingBank resource.-->
																	<attribute id="id" type="guid" value="31d96819-799e-c02e-499c-e22b2f63fba0" />
																</node>
															</children>
														</node>
													</children>
												</node>
												<!--Both of these atmosphere and lighting resources were already part of this scene, by the way! I needed to add them alongside the location switch, because it just used the default Moonrise Towers lighting. You can reference atmosphere and lighting resources that weren't originally part of the scene, though, or even make your own! They don't need to be added elsewhere in the file to work. Just plug them in instead of the UUIDs I used and you're good!-->
											</children>
										</node>
									</children>
								</node>

								<!--End Dialog Tutorial Edits-->

