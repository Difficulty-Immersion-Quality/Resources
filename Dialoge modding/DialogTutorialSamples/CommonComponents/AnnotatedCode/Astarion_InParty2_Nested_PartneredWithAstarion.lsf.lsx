	<!--Start Dialog Tutorial Edits-->

	<!--EnterPhaseSoundEvents is used to play soundtracks and sound effects on entering certain phases of the timeline! I haven't included an example here, but you can find one by looking at the timeline file for Lae'zel's Act 3 romance scene. This is the file path for it:

	\\Public\GustavDev\Timeline\Generated\CAMP_Laezel_ROM_Romance3_MorningIVB.lsf
	
	-->

	<region id="EnterPhaseSoundEvents">
		<node id="EnterPhaseSoundEvents">
			<children>
				<node id="SoundEventMap" />
			</children>
		</node>
	</region>

	<!--Same as EnterPhaseSoundEvents, but controls sound effects and soundtracks on leaving the phase.-->

	<region id="ExitPhaseSoundEvents">
		<node id="ExitPhaseSoundEvents">
			<children>
				<node id="SoundEventMap" />
			</children>
		</node>
	</region>

	<!--Same as EnterPhaseSoundEvents, but for starting the scene as a whole! Often used for soundtracks and ambient noise.-->

	<region id="EnterSoundEvents">
		<node id="EnterSoundEvents" />
	</region>

	<!--Same as ExitPhaseSoundEvents, but on exiting the phase. Often used to grab unique soundtrack elements, designed to close out the song at the end of the scene.-->

	<region id="ExitSoundEvents">
		<node id="ExitSoundEvents" />
	</region>

	<!--End Dialog Tutorial Edits-->

</save>