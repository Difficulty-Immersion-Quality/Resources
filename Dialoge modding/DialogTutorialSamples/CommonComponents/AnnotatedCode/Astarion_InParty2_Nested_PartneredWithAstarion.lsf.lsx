				<!--Start Dialog Tutorial Edits-->

				<!--The PeanutSlotIdMap lists out the actor IDs for the different peanut characters, and their spot behind the player character!-->

				<node id="PeanutSlotIdMap">
					<children>
						<node id="Object">
							<children>
								<node id="Object" key="MapKey">
									<!--The actor UUID for the character in the first peanut slot. These won't correspond to anything in the DialogsBinary file, because they're not actually referring to characters! Instead, these UUIDs are used to map out the different spots behind the player. These slots can actually be used to give peanut characters in a specific position different reactions, expressions, and animations, depending on what slot they're in!-->
									<attribute id="MapKey" type="guid" value="0b2d1337-faae-406d-881d-ae38f4777a5f" />
									<!--The slot number, although I haven't tested which position behind the player this actually corresponds to yet! The positions of the peanut slots can be changed in the dialog scene file, but I'm not sure which entry is which.
									
									Also, like most things in the dialog timeline file, the peanut slots start counting from 0.-->
									<attribute id="MapValue" type="int32" value="0" />
								</node>
								<node id="Object" key="MapKey">
									<!--The actor UUID for the character in the second peanut slot.-->
									<attribute id="MapKey" type="guid" value="3d4d4568-6047-45ed-ad67-2342f9fbfad7" />
									<attribute id="MapValue" type="int32" value="1" />
								</node>
								<node id="Object" key="MapKey">
									<!--The actor UUID for the character in the third peanut slot.-->
									<attribute id="MapKey" type="guid" value="86955144-d8b9-414f-a31b-426c20127d0b" />
									<attribute id="MapValue" type="int32" value="2" />
								</node>
							</children>
						</node>
					</children>
				</node>

				<!--This section is a bit self explanatory; it allows you to configure different settings for the timeline!-->

				<node id="TimelineSettings">
					<!--This setting disables peanut characters globally, even though the Actor IDs for them and PeanutSlotIDMap still need to be present. This means the peanut characters will never be shown, even with the TLShowPeanuts effect component.
					
					To enable peanut characters again, just remove this attribute.-->
					<attribute id="CanShowPeanuts" type="bool" value="False" />
					<!--I'll be honest, I'm not really sure what a lot of these settings do beyond that!-->

					<attribute id="BodyPartForMocap" type="int32" value="1" />
					<attribute id="PlayCount" type="int32" value="-1" />
					<children>
						<node id="FoleySettings" />
						<node id="ExposureSettings" />
						<node id="QuestionHoldAutomation">
							<attribute id="IsEnabled" type="bool" value="False" />
						</node>
					</children>
				</node>
				<!--If a scene involves location switches, the SceneTriggers for those locations will need to be placed in this section! I've explained more about that in that in the sample mod for TLSwitchLocationEvent.-->
				<node id="AdditionalLocations" />
				<!--Not sure about this one! Will have to find a scene where it's actually used, because it doesn't seem to be used often.-->
				<node id="RequiredCinematicLevelTemplateIds" />
				<!--I believe this is used for TLMaterial to reference specific materials within Material Groups to override? This isn't used for every instance of TLMaterial, though. Am still experimenting with it! You can look at Karlach's epilogue dialog files for an example. That file can be found here:
				
				\\Public\GustavDev\Timeline\Generated\EPI_Epilogue_Karlach.lsf

				-->
				<node id="MaterialGroupLookup">
					<children>
						<node id="Object" />
					</children>
				</node>
				<!--Not super sure what this section does. Might be used for specific settings for in-combat automatic/AD dialog? Hm.-->
				<node id="CombatTimelineHandlers">
				<!--End Dialog Tutorial Edits-->
