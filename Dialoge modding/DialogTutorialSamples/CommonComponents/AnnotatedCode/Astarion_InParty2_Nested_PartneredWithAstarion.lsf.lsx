									<attribute id="ID" type="guid" value="ce1f96ed-4e23-151b-42b4-9e3e10ea9dd3" />
									<attribute id="EndTime" type="float" value="18.29" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<attribute id="IsMimicry" type="bool" value="True" />
									<children>
