									<attribute id="StartTime" type="float" value="419.09778" />
									<attribute id="EndTime" type="float" value="423.89777" />
									<attribute id="PhaseIndex" type="int64" value="30" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<attribute id="IsMimicry" type="bool" value="True" />
									<children>
										<node id="Actor">
											<attribute id="UUID" type="guid" value="3d4d4568-6047-45ed-ad67-2342f9fbfad7" />
										</node>
									</children>
								</node>

                                <!--Start Dialog Tutorial Edits-->

								<node id="EffectComponent">
                                    <!--TLEmotionEvent controls character expressions! Facial expressions are usually separate from dialog and lipsyncing (although there are potential exceptions), and are instead handled by a relatively small amount of expression rigs, that can be swapped in at different times via TLEmotionEvent. -->
									<attribute id="Type" type="LSString" value="TLEmotionEvent" />
									<attribute id="ID" type="guid" value="b17982b1-08c9-45e3-a161-938738ae61f2" />
									<attribute id="StartTime" type="float" value="419.09778" />
									<attribute id="EndTime" type="float" value="423.89777" />
									<attribute id="PhaseIndex" type="int64" value="30" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
                                        <!--This is the character the expressions will apply to! In this case, Astarion.-->
										<node id="Actor">
											<attribute id="UUID" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
                                                    <!--The time for the first expression change.-->
													<attribute id="Time" type="float" value="419.09778" />
                                                    <!--InterpolationType for TLEmotionEvent is usually 3!-->
													<attribute id="InterpolationType" type="uint8" value="3" />
                                                    <!--This is the kind of emotion the game will pull from. There's about 12 different possible emotions, including (but not limited to): Happy (emotion 2), Sad (emotion 32), Dead (emotion 512, which is likely used for Speak With Dead), Angry (Emotion 8), and Confusion (emotion 1024).
                                                    
                                                    If you're confused about the numbering, the emotions are actually given ID numbers in multiples of 2! I've got no clue why that is, but I've put a full quick ref sheet for emotions on the BG3 Modding Community Wiki, and have also provided one with these annotated files, in the EmotionRigs_QuickRef.txt file.
                                                    
                                                    In this example, I changed the expression from Happy (emotion 2) to Surprised (emotion 64).-->
													<attribute id="Emotion" type="int32" value="64" />
                                                    <!--Each character usually has about 8 different rigs as variations for a given emotion, and the Variation value ID will point the game towards one of them.
                                                    
                                                    These variation IDs are not in multiples of 2, but instead refer to the rigs by the letter at the end of their file name, starting from zero (i.e. emotion rig Happy_A is Variation 0, Happy_B is Variation 1, Happy_C is Variation 2, etc.) I've also listed out the expression rig variations on the quick ref sheet!
                                                    
                                                    Variations 23, 24, and 25 (corresponding to rigs X, Y, and Z) are usually open mouthed rigs, used for things like laughs, screaming, etc. I've left this unchanged from the original line, because he laughs at the start of it, and needs an open mouthed rig!-->
													<attribute id="Variation" type="int32" value="23" />
                                                    <!--IsSustainedEmotion is usually true by default, and isn't listed. I believe setting it to False will prevent the expression from continuing past the end of the line, but I need to do some more experimenting. It might be good practice to set this for any open mouthed rigs, though; they can look pretty freaky if they're sustained.-->
													<attribute id="IsSustainedEmotion" type="bool" value="False" />
												</node>
												<node id="Key">
                                                    <!--The point in time for the next expression change. A lot of timing within effect components isn't given specific start and end times, they just list 'Time'!-->
													<attribute id="Time" type="float" value="419.5478" />
													<attribute id="InterpolationType" type="uint8" value="3" />
                                                    <!--I also changed his emotion here to Surprised.-->
													<attribute id="Emotion" type="int32" value="64" />
													<!--When the variation is 0, the Variation attribute won't be listed! Variation 0 corresponds to Rig A for an emotion, so this would be referencing the Surprised_A rig for Astarion.-->
												</node>
												<node id="Key">
													<attribute id="Time" type="float" value="421.96777" />
													<attribute id="InterpolationType" type="uint8" value="3" />
                                                    <!--And, again, I changed this to Surprised, specifically the Surprised_B rig.-->
													<attribute id="Emotion" type="int32" value="64" />
                                                    <!--Variation 1 refers to emotion rig B.-->
													<attribute id="Variation" type="int32" value="1" />
												</node>
                                                <!--The last listed emotion in TLEmotionEvent will be carried over to other dialog, until it's changed by another instance of TLEmotionEvent! This is usually the expression the character will have while waiting for player responses.-->
											</children>
										</node>
									</children>
								</node>

                                <!--End Dialog Tutorial Edits-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLLookAtEvent" />
