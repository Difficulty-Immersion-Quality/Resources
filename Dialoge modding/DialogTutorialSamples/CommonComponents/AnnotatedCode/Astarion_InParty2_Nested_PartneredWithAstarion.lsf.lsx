				<!--Start Dialog Tutorial Edits-->

				<!--This section lists out the different Actor UUIDs for the timeline! These can be cross referenced in the DialogsBinary file to figure out which character is which. The MapKey values link to the Speaker ID number for each character in that file. I've included annotated DialogsBinary files in my A New Voice In Town mod, which is included in a separate download on the mod page for these sample mods.-->

				<node id="TimelineSpeakers">
					<children>
						<node id="TimelineSpeaker">
							<children>
								<node id="Object" key="MapKey">
									<!--This links to Speaker ID 0 in the DialogsBinary file! Speaker 0 is usually the character you're speaking to, but it's good practice to double check.-->
									<attribute id="MapKey" type="int32" value="0" />
									<!--The Actor UUID for the character, which is what the timeline file uses to refer to them in the Actors section for the effect components. It's also used for any other instance the character needs to be referenced, like for scenecams attached to them, and their entry in the TimelineActorData section of the file.-->
									<attribute id="MapValue" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
								</node>
								<node id="Object" key="MapKey">
									<!--Links to Speaker ID 1, which is generally the player. Again, it's still good practice to double check, though!-->
									<attribute id="MapKey" type="int32" value="1" />
									<!--The Actor UUID for the player character.-->
									<attribute id="MapValue" type="guid" value="6c70c2df-ab95-d5c1-0db5-c863be615f73" />

									<!--There can be more than two TimelineSpeakers! This file only has two, but that's not always the case. The number of timeline speakers will also be listed in the DialogsBinary file, and will match the TimelineSpeakers entries here.-->
								</node>
							</children>
						</node>
					</children>
				</node>


				<!--TimelineActorData contains information and settings for the different Actors in a scene! It specifies what kind of actor they are i.e. if the actor is a character, camera, object, VFX, etc. Each actor needs to have an entry here, or they won't be able to be referenced by the game.-->

				<node id="TimelineActorData">
					<children>
						<node id="TimelineActorData">
							<children>
								<node id="Object" key="MapKey">
									<!--The UUID for the actor. In this case, Astarion! This links to his UUID in the TimelineSpeakers section.-->
									<attribute id="MapKey" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
									<children>
										<node id="Value">
											<!--His Speaker ID, which matches his TimelineSpeakers ID, and his Speaker ID in the DialogsBinary file.-->
											<attribute id="Speaker" type="int32" value="0" />
											<!--The kind of Actor. In this case, a character, but this can include a lot of different things, from cameras, to lighting, to VFX.-->
											<attribute id="ActorTypeId" type="FixedString" value="character" />
											<!--Not sure! Might label the actor as a character? It's used for peanut characters, even though they have a different ActorTypeId. Hm...-->
											<attribute id="ActorType" type="uint8" value="0" />
											<!--I'm not totally sure what this does, either! For scenecams, it seems to be able to move the camera further out from the character, though. Not sure what it's used for for a character themselves.-->
											<attribute id="DefaultStepOutDelay" type="float" value="0.22244333" />
											<!--Again, not sure.-->
											<attribute id="AudienceSlot" type="uint8" value="16" />
											<!--Corresponds to the actor type for the character in the dialog scene file!-->
											<attribute id="SceneActorType" type="uint8" value="8" />
											<!--Again, not sure ^^' Probably corresponds to something in the dialog scene file, but I'm not sure what.-->
											<attribute id="SceneActorIndex" type="int32" value="0" />
											<children>
												<!--CompiledNodeSnapshots don't seem to affect the game itself! You can leave them unedited, or even delete them if you'd like. Seems to correspond to all the effect components attached to a given actor, though.-->

												<!--End Dialog Tutorial Edits-->
												<node id="CompiledNodeSnapshots">
													<children>
														<node id="ComponentMap">
															<children>
																<node id="Object" key="MapKey">
																	<attribute id="MapKey" type="uint64" value="0" />
																	<children>
																		<node id="ComponentMap">
																			<children>
																				<node id="Cache">
																					<children>
																						<node id="Object" key="MapKey">
																							<attribute id="MapKey" type="uint32" value="3" />
																							<children>
																								<node id="Cache">
																									<children>
																										<node id="ComponentIndex">
																											<attribute id="Object" type="int64" value="9" />
