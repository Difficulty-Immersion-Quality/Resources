                                <!--Start Dialog Tutorial Edits-->

                                <!--Shows Astarions' weapons just before the end of the cinematic. I'll be honest, the all edits I made for this file were real quick, and are just to demonstrate the concepts. The other demo mods are a lot more fun ^^'-->

								<node id="EffectComponent">
                                    <!--TLShowWeapon allows you to toggle the visibility of weapons/instruments during a scene. In this case, it's used to hide both your and Astarion's weapons during the kiss.-->
									<attribute id="Type" type="LSString" value="TLShowWeapon" />
									<attribute id="ID" type="guid" value="f2277aad-5a56-42d8-8225-43e82d329944" />
									<attribute id="StartTime" type="float" value="748.00006" />
									<attribute id="EndTime" type="float" value="766.11005" />
									<attribute id="PhaseIndex" type="int64" value="57" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Actor">
                                            <!--The character the weapons are being hidden for. In this case, Astarion.-->
											<attribute id="UUID" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
										</node>
										<node id="Keys">
											<children>
												<node id="Key">
                                                    <!--The time the weapons will be hidden.-->
													<attribute id="Time" type="float" value="748.00006" />
                                                    <!--This is almost always 3.-->
													<attribute id="InterpolationType" type="uint8" value="3" />
                                                    <!--Setting this to False will hide the weapons!-->
													<attribute id="ShowWeapon" type="bool" value="False" />
												</node>
												<node id="Key">
                                                    <!--The time the weapons will be unhidden.-->
													<attribute id="Time" type="float" value="764.00006" />
													<attribute id="InterpolationType" type="uint8" value="3" />
                                                    <!--To unhide the weapons, just remove the ShowWeapon attribute!-->
												</node>                                                
											</children>
										</node>
									</children>
								</node>

								<!-- TLShowPeanuts -->

								<!--

								So, this was not in the original Patch 6 file! No instance of TLShowPeanuts was. They were included in previous patches, but Larian removed them in an update, instead opting to disable peanuts globally in the timeline settings at the end of the file. I'm not going to enable it again, but I do want to put it here to explain TLShowPeanuts and peanut characters, though.

								Peanut characters are the characters standing behind the player in dialog! They have unique IDs in the timeline file, which you can find in the "PeanutSlotIDMap" section of the file.

								TLShowPeanuts allows you to hide and show those peanut characters at different times! It functions almost identically to TLShowWeapon, only with the ShowPeanuts attribute instead of ShowWeapon. Set ShowPeanuts to False to hide them, and remove ShowPeanuts = False to show them again!

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLShowPeanuts" />
									<attribute id="ID" type="guid" value="96902e90-33a2-4889-90b2-fee2430d8003" />
									<attribute id="StartTime" type="float" value="748.00006" />
									<attribute id="EndTime" type="float" value="766.11005" />
									<attribute id="PhaseIndex" type="int64" value="57" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="Keys">
											<children>
												<node id="Key">
													<attribute id="Time" type="float" value="748.00006" />
													<attribute id="InterpolationType" type="uint8" value="3" />
													<attribute id="ShowPeanuts" type="bool" value="False" />
												</node>
											</children>
										</node>
									</children>
								</node>

								-->

                                <!--End Dialog Tutorial Edits-->

