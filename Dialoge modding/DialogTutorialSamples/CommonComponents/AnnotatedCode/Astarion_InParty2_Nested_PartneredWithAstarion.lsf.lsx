				<!--Start Dialog Tutorial Edits-->

				<!--The TimelinePhases section maps out each dialog node to its PhaseIndex! This can help you cross reference the PhaseIndex for cinematics, which won't have their UUIDs listed in their effect components, unlike dialog nodes with voice lines.-->

				<node id="TimelinePhases">
					<children>
						<node id="Object">
							<children>
								<!--Each phase in the timeline will have a MapKey entry here! And you'll need to add one for each new phase you add to the timeline.
								
								The MapKey entries don't have to be in the same order as the Phases section, even though the Phases section does have to be in order. The MapValues here correspond to the order of the Phases section!-->
								<node id="Object" key="MapKey">
									<!--The UUID for the dialog node in the DialogsBinary file! You want to make sure you put the dialog node UUID here, and not the group ID. Each dialog node in a set of grouped dialog will get its own MapKey entry in the TimelinePhases section, labeled by its UUID. For custom sequences, this will match the CustomSequenceID in the DialogsBinary file!-->
									<attribute id="MapKey" type="guid" value="3f9085aa-262a-4281-aaba-187cab9eb7ef" />
									<!--The MapValue here is the PhaseIndex! There might be multiple entries in the TimelinePhases section with the same MapValue number. This indicates a dialog node is part of grouped dialog, which are all given the same PhaseIndex! Custom sequences, however, will be given unique PhaseIndexes.-->
									<attribute id="MapValue" type="uint64" value="94" />
								</node>

								<!--End Dialog Tutorial Edits-->
