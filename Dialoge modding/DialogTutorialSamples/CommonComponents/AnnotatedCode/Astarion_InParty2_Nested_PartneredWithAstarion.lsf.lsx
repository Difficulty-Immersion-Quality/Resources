									<attribute id="StartTime" type="float" value="412.52777" />
									<attribute id="EndTime" type="float" value="419.09778" />
									<attribute id="PhaseIndex" type="int64" value="29" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<node id="CameraContainer">
											<attribute id="Object" type="guid" value="e50bd2ad-bba5-4455-a53d-08c6b742b404" />
