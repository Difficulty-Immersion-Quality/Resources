								<!--Start Dialog Tutorial Edits-->

								<!--The actor entry for a scenecam!-->

								<node id="Object" key="MapKey">
									<!--The Actor ID of the scenecam, which will be used to refer to it in the dialog timeline file.-->
									<attribute id="MapKey" type="guid" value="56546948-fa49-4bce-92c7-5707e8d19c84" />
									<children>
										<node id="Value">
											<!--Marks the actor as a camera!-->
											<attribute id="ActorTypeId" type="FixedString" value="scenecam" />
											<!--I believe this actor type is used for cameras!-->
											<attribute id="ActorType" type="uint8" value="1" />
											<!--The UUID of the camera in the dialog scene file.-->
											<attribute id="Camera" type="guid" value="190185b2-1b46-402d-9039-15d89b636d84" />
											<!--The actor the camera will be pinned to, usually a character. If the AttachTo and LookAt attributes use different character UUIDs, the camera will be pinned to the character listed for the AttachTo attribute, as an over the shoulder shot. If it's the same as the LookAt attribute, that character will usually be the only character in the shot, and usually indicates a closeup camera.-->
											<attribute id="AttachTo" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
											<!--The character the camera is pointed at! In this case, the camera is both pinned to and looking at Astarion. This is a closeup camera! Having the AttachTo and LookAt attributes be the same doesn't necessarily mean the camera is a closeup camera, but it often is.-->
											<attribute id="LookAt" type="guid" value="baa8d56b-3671-0f79-04fd-4345329cf311" />
											
											<!--Some scenecams don't have AttachTo and LookAt attributes! When those attributes are missing, the camera can be used for unique camera positions, and cameras that aren't necessarily pointed at a character. The default position of the scenecam is instead configured in the dialog scene file!-->

											<!--End Dialog Tutorial Edits-->
											<attribute id="DefaultStepOutDelay" type="float" value="0.42359692" />
