								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLAttitudeEvent" />
									<attribute id="ID" type="guid" value="dd1d9a16-dde6-45c7-9029-bd9ad4dca3ef" />
									<attribute id="StartTime" type="float" value="1231.116" />
									<attribute id="EndTime" type="float" value="1238.046" />
