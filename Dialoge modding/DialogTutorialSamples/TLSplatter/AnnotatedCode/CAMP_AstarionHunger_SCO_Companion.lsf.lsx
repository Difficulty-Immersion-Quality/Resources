								<!--Start Dialog Tutorial Edits-->

								<!--TLSplatter Test. Meant to trigger just after the line 'That - That was amazing' after you convince him to stop biting you.-->
								<node id="EffectComponent">
									<!--Allows you to control skin overlays like blood, sweat, dirt, and bruises within the conversation.-->
									<attribute id="Type" type="LSString" value="TLSplatter" />
									<attribute id="ID" type="guid" value="072594a8-f9a9-46de-994f-29e4b00a07a2" />
									<attribute id="StartTime" type="float" value="80.58104" />
									<attribute id="EndTime" type="float" value="86.101036" />
									<attribute id="PhaseIndex" type="int64" value="4" />
									<attribute id="IsSnappedToEnd" type="bool" value="True" />
									<children>
										<!--The character to get splattered.-->
										<node id="Actor">
											<attribute id="UUID" type="guid" value="2a98b403-4786-e2c0-ac25-9f775a8cefb4" />
										</node>
										<!--There are four available channels for TLSplatter, controlling Blood, Dirt, Bruises, and Sweat, in that order!-->
										<node id="Channels">
											<children>
												<!--Blood-->
												<node id="Channel">
													<!--This refers to the kind of splatter skin overlay. SplatterType 0 is Blood.-->
													<attribute id="SplatterType" type="uint8" value="0" />
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--This is the amount of blood/etc that will be shown on the character, on a scale of 0 to 1. This one sets blood to max. If you'd like to halve that, you'd put 0.5 here, 0.3 for about a third, etc. There won't be a value attribute if the amount of blood/dirt/etc is 0, though!-->
																	<attribute id="Value" type="float" value="1" />
																</node>															
															</children>
														</node>
													</children>														
												</node>
												<!--Dirt-->
												<node id="Channel">
													<!--SplatterType 1 is Dirt!-->
													<attribute id="SplatterType" type="uint8" value="1" />
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="2" />
																	<!--Removing the Value attribute will set the splatter value to 0.-->
																</node>
															</children>
														</node>
													</children>														
												</node>
												<!--Bruises-->
												<node id="Channel">
													<!--SplatterType 2 is Bruises!-->
													<attribute id="SplatterType" type="uint8" value="2" />
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="2" />
																</node>
															</children>
														</node>
													</children>													
												</node>
												<!--Sweat-->
												<node id="Channel">
													<!--SplatterType 3 is Sweat!-->
													<attribute id="SplatterType" type="uint8" value="3" />
													<children>
														<node id="Keys">
															<children>
																<node id="Key">
																	<attribute id="InterpolationType" type="uint8" value="2" />
																</node>
															</children>
														</node>
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>			

								<!--End Dialog Tutorial Edits-->

								<node id="EffectComponent">
									<attribute id="Type" type="LSString" value="TLAnimation" />
									<attribute id="ID" type="guid" value="93ae2c45-08e0-4b87-8a7d-9735c4911869" />
									<attribute id="StartTime" type="float" value="81.20104" />
									<attribute id="EndTime" type="float" value="81.85104" />
									<attribute id="PhaseIndex" type="int64" value="4" />
									<attribute id="AnimationSourceId" type="guid" value="ca0374c1-d02e-4f3f-b740-7fdea5ee9d59" />
									<attribute id="AnimationPlayStartOffset" type="double" value="0.9" />
									<attribute id="FadeIn" type="double" value="0" />
									<attribute id="FadeOut" type="double" value="0" />
									<attribute id="OffsetType" type="uint8" value="5" />
									<attribute id="EnableRootMotion" type="bool" value="True" />
									<attribute id="AnimationGroup" type="guid" value="fa77ba25-0bea-4b1f-b8e9-dbd02759fdaa" />
									<attribute id="Continuous" type="bool" value="True" />
