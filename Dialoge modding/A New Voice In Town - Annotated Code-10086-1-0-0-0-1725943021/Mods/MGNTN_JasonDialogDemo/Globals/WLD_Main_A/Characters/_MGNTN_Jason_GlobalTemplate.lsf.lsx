					<attribute id="Icon" type="FixedString" value="1323c4b6-92f7-4fda-8bad-6a96b8ddbc73_(MGNTN_Jason-Icon-01)" />
					<!--If this is True, this is generally a character that will appear in multiple acts and/or areas of the world.-->
					<attribute id="IsGlobal" type="bool" value="True" />	
                    <!--Can you loot this character's body after death?-->
                    <attribute id="IsLootable" type="bool" value="True" />	
					<!--Level the character can be found in-->	
