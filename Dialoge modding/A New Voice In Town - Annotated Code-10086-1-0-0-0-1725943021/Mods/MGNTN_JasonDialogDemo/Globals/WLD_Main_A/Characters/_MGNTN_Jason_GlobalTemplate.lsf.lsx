	<region id="Templates">
		<node id="Templates">
			<children>

				<!--Global root template for the character included in this demo, my OC Jason. Treat him kindly!-->

				<node id="GameObjects">
					<!--Links to the character's Anubis script configuration-->
					<attribute id="AnubisConfigName" type="FixedString" value="MGNTN_JasonDemo" />
					<attribute id="Archetype" type="FixedString" value="mage_smart" />
					<!--Links to the character's appearance template. His head mesh resource has been changed in the unpacked template files, just so you know!-->
					<attribute id="CharacterVisualResourceID" type="FixedString" value="c758c0da-4b91-41ed-969d-830ae1ff2d33" />
					<!--Put the Dialog Resource ID for your dialogue here-->
					<attribute id="DefaultDialog" type="FixedString" value="c37c312f-f63e-488c-bdd8-541355984132" />
					<!--The name of the character. Links to a localization file entry.-->
					<attribute id="DisplayName" type="TranslatedString" handle="h20740c25ce4b4f2bb42f236dbafdd758bf0a" version="2" />
					<attribute id="Equipment" type="FixedString" value="EQP_Staff_Robe" />
