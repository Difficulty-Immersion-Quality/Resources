											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
                                                            <!--Text: 'If I stumble on your corpse later, I'll be quite cross!'-->
															<attribute id="TagText" type="TranslatedString" handle="h93c7ba65c46e4457bb9783033cfbef1a723b" version="3" />
															<attribute id="LineId" type="guid" value="3d8a08ae-d7eb-467b-8b65-5c02ec7964cc" />
