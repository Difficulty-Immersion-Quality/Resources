													<attribute id="UUID" type="FixedString" value="2c60c719-c09f-4fa5-a1a1-8e5dbec6f1b6" />
													<!--Once again, this dialogue is testing to see whether the HasMet flag is True.-->
													<attribute id="value" type="bool" value="True" />
													<attribute id="paramval" type="int32" value="1" />
												</node>
											</children>
										</node>
										<node id="flaggroup" key="type">
											<attribute id="type" type="FixedString" value="Global" />
											<children>
												<node id="flag" key="UUID">
													<!--This flag is checking for the MGNTN_PlayerIntimidatedJason flag I created again.-->
													<attribute id="UUID" type="FixedString" value="a93af79a-6bec-4ad8-9b6f-8c1bdc924e40" />
													<!--And specifically, it's checking to see whether the flag is True. Aw. Meanie...-->
													<attribute id="value" type="bool" value="True" />
												</node>
											</children>
										</node>										
									</children>
								</node>
								<node id="TaggedTexts">
									<children>
