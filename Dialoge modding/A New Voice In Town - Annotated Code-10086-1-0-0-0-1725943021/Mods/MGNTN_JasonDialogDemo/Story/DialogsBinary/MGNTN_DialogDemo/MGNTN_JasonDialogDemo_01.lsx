						<!--This player response is designed to close out the conversation.-->
						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagQuestion" />
							<attribute id="UUID" type="FixedString" value="26d49997-770a-4866-b9d2-468bfb7abf6f" />
							<attribute id="endnode" type="bool" value="True" />
							<!--ShowOnce is also sometimes necessary to properly close out dialog! I haven't found a consistent pattern yet, though.-->
							<attribute id="ShowOnce" type="bool" value="True" />
							<attribute id="speaker" type="int32" value="1" />
							<children>
								<node id="children" />
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--TaggedText: 'Leave.'-->
															<attribute id="TagText" type="TranslatedString" handle="hb7d239eage942g4c0cg9215gcc05b130cf08" version="1" />
															<attribute id="LineId" type="guid" value="67e98d34-fea9-4c32-a9e1-a58bba7b7ce1" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
								<node id="ValidatedFlags">
									<attribute id="ValidatedHasValue" type="bool" value="False" />
								</node>
							</children>
						</node>



						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagGreeting" />
							<attribute id="UUID" type="FixedString" value="e403b39b-4ebc-402b-b227-c99c51605998" />
							<attribute id="Root" type="bool" value="True" />
