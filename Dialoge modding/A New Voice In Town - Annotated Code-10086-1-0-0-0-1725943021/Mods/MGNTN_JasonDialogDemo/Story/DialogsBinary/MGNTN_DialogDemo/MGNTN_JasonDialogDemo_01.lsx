						<node id="node" key="UUID">
							<!--A jump dialogue node. This kind of node will allow you to jump to different parts of the timeline.-->
							<attribute id="constructor" type="FixedString" value="Jump" />
							<attribute id="UUID" type="FixedString" value="d8ed6489-86a3-4a13-9463-06fa81872719" />
							<!--The dialogue node to jump to.-->
							<attribute id="jumptarget" type="FixedString" value="bfadb532-41f1-4409-8f01-6598d789856d" />
							<!--Allows you to jump to the line of dialogue and play it, or skip it entirely, which is helpful for passive rolls and returning to previous sets of dialogue options without replaying the line.
                            
                            jumptargetpoint 1 will take you to the line itself, and jumptargetpoint 2 will skip it!-->
							<attribute id="jumptargetpoint" type="uint8" value="1" />
							<children>
								<node id="children" />
								<node id="Tags" />
								<node id="setflags" />
