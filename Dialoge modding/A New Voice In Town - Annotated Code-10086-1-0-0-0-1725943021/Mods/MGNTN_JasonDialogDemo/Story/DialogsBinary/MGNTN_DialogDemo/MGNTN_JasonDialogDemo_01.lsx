													<children>
														<node id="TagText">
															<!--Text: 'I hope that little gold piece I tossed you wasn't too hard to find...'-->
															<attribute id="TagText" type="TranslatedString" handle="hc00842d2502d4d1e8d4aad233d2e66c81gfd" version="3" />
															<attribute id="LineId" type="guid" value="e66ae43c-a720-44f9-8826-52979d523c58" />
