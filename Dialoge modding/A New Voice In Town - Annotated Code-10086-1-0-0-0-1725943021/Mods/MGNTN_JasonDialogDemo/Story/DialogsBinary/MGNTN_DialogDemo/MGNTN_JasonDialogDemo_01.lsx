							</children>
						</node>	                        

						<node id="node" key="UUID">
                            <!--A nested dialog node can link to other dialog files! Often this is for specific types of conversations, like for romance dialog, but sometimes cutscenes and story moments, like the scene in Act 2 with the Nightsong, are split up into nested dialog files, too.
                            
                            You'll need to add the Dialog Resource of the nested dialog as a child of the Dialog Resource of the original dialog in order to link from one to the other, though. More information can be found in the Dialog Assets file, which has the Dialog Resource entries for Jason's dialog. That can be found in this file path here:
                            
                            \\MGNTN_JasonDialogDemo\Public\MGNTN_JasonDialogDemo\Content\Assets\Dialogs\MGNTN_DialogDemo\_MGNTN_JasonDialogDemo_DialogResource01.lsf-->
							<attribute id="constructor" type="FixedString" value="Nested Dialog" />
                            <!--The UUID of this specific dialog node, which can be referenced as a child of another node in this file to select the nested dialog.-->
							<attribute id="UUID" type="FixedString" value="a0bf5e45-9c51-4405-8ba0-0ed63a46dec4" />
                            <!--The Dialog Resource ID for the dialog file you're jumping to.-->
							<attribute id="NestedDialogNodeUUID" type="guid" value="6a881524-9bcb-436e-885c-8267410c544d" />
							<children>
								<node id="children">
									<children>
										<node id="child">
                                            <!--The UUID of the dialog node you're jumping to.-->
											<attribute id="UUID" type="FixedString" value="2f61043b-199c-4317-876d-732a2b1ddead" />
										</node>
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="SpeakerLinking">
									<children>
										<node id="SpeakerLinkingEntry">
											<attribute id="Key" type="int32" value="0" />
											<attribute id="Value" type="int32" value="0" />
										</node>
										<node id="SpeakerLinkingEntry">
											<attribute id="Key" type="int32" value="1" />
											<attribute id="Value" type="int32" value="1" />
										</node>
									</children>
								</node>
							</children>
						</node>



						<!--Used to list the UUIDs for lines of dialogue that can be shown first in a conversation. There can be more than one root dialogue node! These are usually TagGreeting nodes, and are Root = True attribute. You can test for multiple TagGreeting nodes using the checkflags attribute, like I do in this file.-->
						<node id="RootNodes">
							<attribute id="RootNodes" type="FixedString" value="194918e5-fe1a-4a56-b902-45f7ad9f1a10" />
						</node>	
