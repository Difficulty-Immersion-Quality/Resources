<?xml version="1.0" encoding="utf-8"?>
<save>
	<version major="4" minor="6" revision="0" build="0" lslib_meta="v1,bswap_guids,lsf_keys_adjacency" />
	<region id="dialog">
		<node id="dialog">
			<!--The kind of dialogue scene the file is for. This is just for NPCs, but you can specify Companion dialogue as well, etc.-->
			<attribute id="category" type="LSString" value="Generic NPC Dialog" />
			<!--Generate a new UUID here. This doesn't seem to be referenced elsewhere, but still important.-->
			<attribute id="UUID" type="FixedString" value="4ad0f91d-f344-419a-ae14-74d3d58e337a" />
			<!--The UUID for the timeline listed in your GeneratedDialogTimelines entry for the scene.-->
			<attribute id="TimelineId" type="FixedString" value="4dafc4e4-ed8c-484a-8041-e6e1d3342e70" />
			<children>
				<node id="DefaultAddressedSpeakers">
					<children>
						<node id="Object" key="MapKey">
							<attribute id="MapKey" type="int32" value="0" />
							<attribute id="MapValue" type="int32" value="-1" />
						</node>
						<node id="Object" key="MapKey">
							<attribute id="MapKey" type="int32" value="1" />
							<attribute id="MapValue" type="int32" value="-1" />
						</node>
					</children>
				</node>
				<!--A list of characters who can participate in a dialogue, mapping out the speaker and timeline actor IDs of each character. This conversation only has two, but that isn't always the case.-->
				<node id="speakerlist">
					<children>
						<node id="speaker" key="index">
							<!--Used to determine speakers -->
							<attribute id="index" type="FixedString" value="0" />
							<!--The UUID of the character speaking, in this case Jason.-->
							<attribute id="list" type="LSString" value="1323c4b6-92f7-4fda-8bad-6a96b8ddbc73" />
							<!--The TimelineSpeakers and actor ID for the character, which is how they're referred to in the timeline file.-->
							<attribute id="SpeakerMappingId" type="guid" value="364f518b-9f52-4fb6-a405-c1b5718bf67f" />
						</node>
						<node id="speaker" key="index">
							<attribute id="index" type="FixedString" value="1" />
							<!--The UUID for the player character!-->
							<attribute id="list" type="LSString" value="e0d1ff71-04a8-4340-ae64-9684d846eb83" />
							<!--And again, the TimelineSpeakers and actor ID for the character in the timeline file.-->
							<attribute id="SpeakerMappingId" type="guid" value="64c3716a-9fc7-4bbb-9b22-063832b6b7aa" />
						</node>
					</children>
				</node>
				<node id="nodes">
					<children>
						<node id="node" key="UUID">
							<!--The type of dialogue node. This is a TagGreeting node, which is the first line of dialogue a character will have in a conversation. There can be multiple TagGreeting nodes in a dialogue file!-->
							<attribute id="constructor" type="FixedString" value="TagGreeting" />
							<!--The UUID of the dialogue node. Generate a new one when adding new dialogue.-->
							<attribute id="UUID" type="FixedString" value="194918e5-fe1a-4a56-b902-45f7ad9f1a10" />
							<!--Is this the start of a conversation? If so, this dialogue node should have a corresponding Root Node entry at the end of a file.-->
							<attribute id="Root" type="bool" value="True" />
							<!--The speaker ID of the character the dialogue node belongs to, as listed above and in the timeline file. Speaker 0 is generally the character being spoken to! And Speaker 1 is generally the player character, with additional speakers after that being other characters who can join in on a conversation.-->
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<!--The UUIDs of the dialogue nodes that will come next. A dialogue node can have multiple children, which can be either player responses, or links to dialogue that's being tested, some of which may not always be available..-->
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="1a97e532-61e1-4cc7-8105-7c6aa2a3bd1a" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<!--This section seems to let you tag for different kinds of dialogue, like if the dialogue is telepathic/using illithid mind melds/etc.-->
								<node id="Tags" />
								<!--Can be used to set game flags, which can be tested for later. It can also be used to unset flags, depending on whether the flag is set to true or false by this section. This one sets the HasMet flag for Jason.-->
								<node id="setflags">
									<children>
										<node id="flaggroup" key="type">
											<!--The type of flag being set. Dialog tags are most often used for HasMet flags, to see if a specific character has met another character, or seen a specific initial dialog before. These are set on a per character basis, so speaking to the character with one character will not set the HasMet flag for another.-->										
											<attribute id="type" type="FixedString" value="Dialog" />
											<children>
												<node id="flag" key="UUID">
													<!--The UUID of the flag being set.-->
													<attribute id="UUID" type="FixedString" value="2c60c719-c09f-4fa5-a1a1-8e5dbec6f1b6" />
													<!--You can set the flag to True to set the flag, or False to unset it.-->
													<attribute id="value" type="bool" value="True" />
													<attribute id="paramval" type="int32" value="1" />
												</node>
											</children>
										</node>
									</children>
								</node>
								<!--This is used to check whether the dialogue should be available or not, based on game flags and character tags.-->
								<node id="checkflags">
									<children>
										<node id="flaggroup" key="type">
											<attribute id="type" type="FixedString" value="Dialog" />
											<children>
												<node id="flag" key="UUID">
													<!--The UUID of the flag being checked for. This one is checking for the HasMet flag for Jason!-->
													<attribute id="UUID" type="FixedString" value="2c60c719-c09f-4fa5-a1a1-8e5dbec6f1b6" />
													<!--This dialogue will only play if the HasMet flag for Jason is False.-->
													<attribute id="value" type="bool" value="False" />
													<attribute id="paramval" type="int32" value="1" />
												</node>
											</children>
										</node>
									</children>
								</node>
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<!--This is almost always true, even if there aren't actually rules given.-->
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--The text handle for your dialogue. Links to your Localization file for the captions, as well as the character's Voicebank file to call up the audio, lipsync, and animation files for the dialogue. The text for this handle in my Localization files is 'It's you! The mighty defenders of this little grove.'-->
															<attribute id="TagText" type="TranslatedString" handle="h3c280632737c454b9f1bac7cef87a669201d" version="3" />
															<!--Generate new UUID here.-->
															<attribute id="LineId" type="guid" value="f5e96c36-8df4-40d2-b0fe-124974388ce2" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<!--There can be multiple possible lines of dialog in one dialog node! Sometimes this is used to add randomized dialog, and sometimes it's used in combination with RuleGroups, to test for certain conditions for each line. A good example of this is in the epilogue, with the game testing to see whether your character is an illithid, and switching to put lines in italics if they are.
												
												I've explained a bit more about this, and the related CustomSequenceIDs later in the file! Search for 'About Custom Sequences' in the file to find it.-->
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>


						<node id="node" key="UUID">
							<!--The type of dialogue node. This is a TagAnswer node, which is used for when a character is speaking.-->
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="1a97e532-61e1-4cc7-8105-7c6aa2a3bd1a" />
							<!--Again, this is usually 0, but if multiple characters have voice lines in a scene, this speaker ID should match the one for the character with the line.-->
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="ba5e064d-df90-4008-acf0-363540c8bf9f" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'There's not many who would stick their necks out for others like that.'-->
															<attribute id="TagText" type="TranslatedString" handle="h6f24a6cdedb2436d9dd8bb4b1ff6462ed0b0" version="3" />
															<attribute id="LineId" type="guid" value="08c3a111-ec31-490e-873f-978b73c4a26a" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="ba5e064d-df90-4008-acf0-363540c8bf9f" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<!--The children listed here are player responses! This dialogue node is acting like a 'hub' for player responses, with each possible response listed as a 'child' under it. The order of each player response option listed here will also be the order they'll be listed in-game.-->
										<node id="child">
											<attribute id="UUID" type="FixedString" value="62808758-585b-4b3b-9c1f-ae9d3bb253b5" />
										</node>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="04baa403-611c-439f-94b3-ba3c82b01a96" />
										</node>																
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'Thank you. It means a lot.'-->
															<attribute id="TagText" type="TranslatedString" handle="h580e6615c3364b05843d7575309ad942e568" version="3" />
															<attribute id="LineId" type="guid" value="27da29e5-f949-4d44-9657-fbf127e9b144" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	


						<node id="node" key="UUID">
							<!--The type of dialogue node. This time a TagQuestion node, which is a player dialogue option!-->
							<attribute id="constructor" type="FixedString" value="TagQuestion" />
							<!--The UUID of the file containing approval rating values for the interaction. In this case, Astarion should get +1 approval, and Wyll should get -1. HOWEVER. Just setting up this approval rating ID file will not trigger the approval. I'm still looking into how approval is configured by the game. But! Just for reference, this is still how approval is noted by the game in dialog.-->
							<attribute id="ApprovalRatingID" type="guid" value="2ff8b964-5210-4b52-8b35-2dc2c56970b3" />
							<attribute id="UUID" type="FixedString" value="62808758-585b-4b3b-9c1f-ae9d3bb253b5" />
							<!--Since this is a player response, the speaker ID here should match that of the player's, listed at the top of the file. This is almost always 1.-->
							<attribute id="speaker" type="int32" value="1" />
							<children>
								<node id="children">
									<children>
										<!--The possible responses from the other character will be listed as a child here. There's only one here, but that isn't always the case!-->
										<node id="child">
											<attribute id="UUID" type="FixedString" value="c7c44110-22b6-4e33-9b80-b0b657006bdf" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'Don't thank me. I don't work for free - and I take my payment up front.'-->
															<attribute id="TagText" type="TranslatedString" handle="h56fc2f953493498e9e92776470a0e0f8ba0b" version="3" />
															<attribute id="LineId" type="guid" value="88a8aac5-e8df-4f40-8ef4-b1f78dcaee35" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>



						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="c7c44110-22b6-4e33-9b80-b0b657006bdf" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="d75efb27-5026-432e-8865-8abe3c8e6f82" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'Oh, that's a shame.'-->
															<attribute id="TagText" type="TranslatedString" handle="h078dfca2243845789a0afb48381aeb946112" version="3" />
															<attribute id="LineId" type="guid" value="8f94b5d4-d946-4c2c-b7e1-cfddbbd0a454" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>						


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="d75efb27-5026-432e-8865-8abe3c8e6f82" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="2c88c164-8dd3-4b91-867d-ba9a33a1a25c" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'I hadn't pegged you for a common mercenary.'-->
															<attribute id="TagText" type="TranslatedString" handle="hc648329e90de4c0084ab6d9afba1b67e37e2" version="3" />
															<attribute id="LineId" type="guid" value="ca024d47-21be-4ba9-af9b-5d7eff6df3dd" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	



						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="2c88c164-8dd3-4b91-867d-ba9a33a1a25c" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="60fd425c-6ad3-4cf5-bc63-e47e00bcec60" />
										</node>									
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'That's a bit dull...'-->
															<attribute id="TagText" type="TranslatedString" handle="h3227e20f28de4068a11b4a896b67a564c5ed" version="3" />
															<attribute id="LineId" type="guid" value="50ccbd70-a691-4161-acd6-01cd32a28e49" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	

						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="60fd425c-6ad3-4cf5-bc63-e47e00bcec60" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<!--This is another example of player dialogue options!-->
										<node id="child">
											<attribute id="UUID" type="FixedString" value="4e2b99e6-8498-4158-9652-8eca30d17f99" />
										</node>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="798a3dc5-f267-48dc-a1f3-23950bbf0e16" />
										</node>									
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: '...don't you think?'-->
															<attribute id="TagText" type="TranslatedString" handle="h8486e39e7fb947f08da1908ebb50239b867f" version="3" />
															<attribute id="LineId" type="guid" value="dc76dd3c-c28a-4229-910d-9cb2347a6b7b" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	


						<node id="node" key="UUID">
							<!--The type of dialogue node. This time an ActiveRoll node, which is a dialogue node where the player is prompted to make a dice roll to determine the next lines of dialogue in a conversation.
                            
                            PassiveRoll nodes are Extremely similar so I've not included an example in this mod. They use the same code structure as ActiveRoll nodes, just with the PassiveRoll constructor tag instead! The only difference besides that tag is that the roll will be done automatically by the game, without the player being prompted to roll for the outcome, but they're otherwise identical within the code.-->
							<attribute id="constructor" type="FixedString" value="ActiveRoll" />
							<attribute id="UUID" type="FixedString" value="4e2b99e6-8498-4158-9652-8eca30d17f99" />
							<attribute id="transitionmode" type="uint8" value="2" />
							<!--Again, the speaker for this node should match the player.-->
							<attribute id="speaker" type="int32" value="1" />
							<!--This roll is checking a specific skill, Intimidation. If the check is just for a raw ability score, there won't be anything listed for the RollType here (although the attribute will still be listed), and the Skill attribute will also be empty, leaving just the ability being tested.-->
							<attribute id="RollType" type="string" value="SkillCheck" />
							<!--The base ability of the skill check.-->
							<attribute id="Ability" type="string" value="Charisma" />
							<!--The specific skill the check is for.-->
							<attribute id="Skill" type="string" value="Intimidation" />
							<!--The character the roll is being made against.-->
							<attribute id="RollTargetSpeaker" type="int32" value="0" />
							<!--This can be used to set situational advantage, but this node does not have situational advantage.-->
							<attribute id="Advantage" type="uint8" value="0" />
							<!--Should you exclude the extra bonuses to rolls companions can give you, like Guidance? In this case, no. Guide away.-->
							<attribute id="ExcludeCompanionsOptionalBonuses" type="bool" value="False" />
							<!--Same as above, only it's for the character making the roll.-->
							<attribute id="ExcludeSpeakerOptionalBonuses" type="bool" value="False" />
							<!--This links to the specific difficulty class for the roll, which is listed in the DifficultyClasses.lsx file. In this case, the difficulty class is 10.-->
							<attribute id="DifficultyClassID" type="guid" value="fa621d38-6f83-4e42-a55c-6aa651a75d46" />
							<children>
								<node id="children">
									<children>
										<!--The children listed here are RollResult nodes, which will determine the path the dialogue takes based on whether the roll succeeded or not.-->
										<node id="child">
											<attribute id="UUID" type="FixedString" value="4eedb6b3-e4c9-442f-ada9-4d49f9f3159e" />
										</node>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="a63379b1-3a27-4bf9-b2a8-943dd49155cf" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags">
									<children>
										<node id="flaggroup" key="type">
										<!--A Global flag refers to flags that apply to the game broadly, and not just to specific characters.-->
											<attribute id="type" type="FixedString" value="Global" />
											<children>
												<node id="flag" key="UUID">
													<!--The UUID of the flag being set. In this case, it's a flag to indicate you tried to intimidate Jason, which will change his response to you later.-->
													<attribute id="UUID" type="FixedString" value="a93af79a-6bec-4ad8-9b6f-8c1bdc924e40" />
													<!--This sets the flag to true.-->
													<attribute id="value" type="bool" value="True" />
													<attribute id="paramval" type="int32" value="1" />
												</node>
											</children>
										</node>
									</children>
								</node>
								<node id="checkflags" />
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: 'And yet the blade of a knife is so sharp.'-->
															<attribute id="TagText" type="TranslatedString" handle="h4ff847e270644da4b0332cb3ea15c923ac69" version="2" />
															<attribute id="LineId" type="guid" value="e2fa305a-bc63-4b56-8afc-c58c28e3906a" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
								<node id="ValidatedFlags">
									<attribute id="ValidatedHasValue" type="bool" value="False" />
								</node>
							</children>
						</node>


						<node id="node" key="UUID">
							<!--This type of dialogue node determines the path taken depending on the result of the dice roll!-->
							<attribute id="constructor" type="FixedString" value="RollResult" />
							<attribute id="UUID" type="FixedString" value="4eedb6b3-e4c9-442f-ada9-4d49f9f3159e" />
							<!--This will determine the path the dialogue takes if the roll succeeded.-->
							<attribute id="Success" type="bool" value="True" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="57e523d8-ab96-4cc8-8a22-27455114a294" />
										</node>
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
							</children>
						</node>


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="RollResult" />
							<attribute id="UUID" type="FixedString" value="a63379b1-3a27-4bf9-b2a8-943dd49155cf" />
							<!--This will determine the path the dialogue takes if the roll failed.-->
							<attribute id="Success" type="bool" value="False" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="200e4d7c-ccb9-49dd-a0ce-ac4124725a0f" />
