							<!--Used to end the dialogue. This is the end of the conversation! Or, one branch of it, at least.-->
							<attribute id="endnode" type="bool" value="True" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<!--Having nothing listed for the children of a dialogue node can actually bring you back to the last set of player response options you were given, but in this case, since it's the end of the dialogue, you'll just exit the conversation.-->
