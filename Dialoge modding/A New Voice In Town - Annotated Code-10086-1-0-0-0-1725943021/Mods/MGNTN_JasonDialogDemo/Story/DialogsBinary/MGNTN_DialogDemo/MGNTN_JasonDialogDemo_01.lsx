						<node id="node" key="UUID">
							<!--This dialogue node is used for cinematics! Animations, cutscenes, etc.-->
							<attribute id="constructor" type="FixedString" value="TagCinematic" />
							<attribute id="UUID" type="FixedString" value="bfadb532-41f1-4409-8f01-6598d789856d" />
							<!--The speaker ID for cinematics is almost always -1, most likely to allow any character in the scene to participate.-->
							<attribute id="speaker" type="int32" value="-1" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="117a4894-5684-4fca-a7a2-bf619e189cb8" />
										</node>
									</children>
								</node>
