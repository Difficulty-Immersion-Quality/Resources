									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<node id="editorData">
									<children>
										<node id="data" key="key">
											<!--Can be used to list notes for yourself wrt what the cinematic is and its context. Not used by the game itself, it's just for you.-->
											<attribute id="key" type="FixedString" value="CinematicNodeContext" />
											<attribute id="val" type="LSString" value="Jason tosses coin into haystack." />
										</node>
									</children>
								</node>								
								<!--Cinematics also generally do not have tagged texts, so that attribute is not present here.-->
							</children>
						</node>		



						<node id="node" key="UUID">
