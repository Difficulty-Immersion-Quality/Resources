						</node>	


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagGreeting" />
							<attribute id="UUID" type="FixedString" value="0610cd4c-b761-4124-afa8-53fe0ca17fc7" />
							<attribute id="Root" type="bool" value="True" />
							<!--ShowOnce will prevent the dialog from being shown multiple times while you're talking to a character! This won't prevent it from showing if the conversation ends, and you talk to the character again. If the game flags are still valid for it to trigger, it'll be available again.-->
							<attribute id="ShowOnce" type="bool" value="True" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="ca2fc932-b8e2-4d11-a08f-ecba751a87ad" />
										</node>
									</children>
								</node>
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags">
									<children>
										<node id="flaggroup" key="type">
											<attribute id="type" type="FixedString" value="Dialog" />
											<children>
												<node id="flag" key="UUID">
													<attribute id="UUID" type="FixedString" value="2c60c719-c09f-4fa5-a1a1-8e5dbec6f1b6" />
													<!--Again, this is where you check game flags to see if a line of dialogue should be available or not. This dialogue will only play if the HasMet flag for Jason is True! This flag was set earlier in the file, when the game was checking to see if HasMet flag for him was False. That line of dialogue should now be inaccessible, and this one should be accessible instead.-->
													<attribute id="value" type="bool" value="True" />
													<attribute id="paramval" type="int32" value="1" />
												</node>
											</children>
										</node>
										<node id="flaggroup" key="type">
											<!--A Global flag refers to flags that apply to the game broadly, and not just to specific characters.-->
											<attribute id="type" type="FixedString" value="Global" />
											<children>
												<node id="flag" key="UUID">
													<!--This flag is checking for the MGNTN_PlayerIntimidatedJason flag I created, which is set if the player tried to intimidate Jason in their first conversation with him.-->
													<attribute id="UUID" type="FixedString" value="a93af79a-6bec-4ad8-9b6f-8c1bdc924e40" />
													<!--And specifically, it's checking to see whether the flag is False, meaning you didn't try to intimidate him. Be nice to him please <3-->
													<attribute id="value" type="bool" value="False" />
												</node>
											</children>
										</node>										
									</children>
								</node>
								<node id="TaggedTexts">
									<children>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--Text: '...Dance upon the stars, tonight...'-->
															<attribute id="TagText" type="TranslatedString" handle="h76469642791b4be581d35236815f374d6291" version="3" />
															<attribute id="LineId" type="guid" value="ced061da-6bec-46c9-8782-beb1ee5ee0d3" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagAnswer" />
							<attribute id="UUID" type="FixedString" value="ca2fc932-b8e2-4d11-a08f-ecba751a87ad" />
							<attribute id="speaker" type="int32" value="0" />
							<children>
								<node id="children">
									<children>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="64350cc1-39b1-4c44-a705-90a0ff4eff80" />
										</node>
										<node id="child">
											<attribute id="UUID" type="FixedString" value="26d49997-770a-4866-b9d2-468bfb7abf6f" />
										</node>
									</children>
								</node>                                
								<node id="GameData">
									<children>
										<node id="AiPersonalities" key="AiPersonality" />
										<node id="MusicInstrumentSounds" />
										<node id="OriginSound" />
									</children>
								</node>
								<node id="Tags" />
								<node id="setflags" />
								<node id="checkflags" />
								<!--About Custom Sequences-->

								<!--Sometimes, you can add multiple lines of dialog within the same node, and give them a unique entry in the timeline file using the 'CustomSequenceID' attribute!
								
								This is used for randomized dialog, like greetings, but also can be used to test for things like pronouns, whether the character is talking to a specific origin character, etc. This is super helpful if you want different lines that lead to the same places in the dialog tree! You shouldn't have to make multiple branches in a dialog tree just to respect someone's pronouns. And with this, you won't have to!
								
								You can also have multiple tagged texts for player responses, to insert different text depending on certain conditions, too. In those cases, you wouldn't put a custom sequence ID.-->
								<node id="TaggedTexts">
									<children>
										<!--TaggedText can help group specific lines of text together, that are tested for a given rule. All lines within the same TaggedText entry will test for that rule. There can be multiple TaggedText entries in a TaggedTexts section!-->
										<node id="TaggedText">
											<!--This is usually True, even when nothing's being tested for.-->
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<!--Groups together all the different possible lines that can trigger based on the rule. When multiple lines are listed in the TagTexts section, the game will usually randomize between them. You can look to companion InParty greetings for examples!-->
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--The text handle for this line of dialog. In this case, it's, 'Now, where did I hear that?'-->
															<attribute id="TagText" type="TranslatedFSString" value="" handle="h1a12158b1f77436dbc297a71d61ed85cb636" arguments="0" />
															<!--UUID for this line specifically. This usually matches the CustomSequenceID!-->
															<attribute id="LineId" type="guid" value="c2e05307-ac80-4afc-ba5f-346b3b6c9704" />
															<!--The CustomSequenceID is used in the dialog timeline file to identify which line it needs to play! It's used to identify the line's unique PhaseIndex, and is also used to pull the correct audio for TLVoice, which I've explained more in Jason's timeline file.-->
															<attribute id="CustomSequenceId" type="guid" value="c2e05307-ac80-4afc-ba5f-346b3b6c9704" />															
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<!--The rules the lines are testing for.-->
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules">
															<children>
																<node id="Rule">
																	<attribute id="HasChildRules" type="bool" value="False" />
																	<attribute id="speaker" type="int32" value="1" />
																	<attribute id="TagCombineOp" type="uint8" value="0" />
																	<children>
																		<node id="Tags">
																			<children>
																				<!--I'm testing for the REALLY_DARK_URGE tag here.
																				
																				Note: I've only been able to find ingame examples testing for tags in custom sequences, but I'm not totally convinced you can't test for other game conditions. Will have to experiment more.-->
																				<node id="Tag">
																					<attribute id="Object" type="guid" value="cd611d7d-b67d-42b4-a75c-a0c6091ef8a2" />
																				</node>
																			</children>
																		</node>
																	</children>
																</node>
															</children>
														</node>
													</children>
												</node>
											</children>
										</node>
										<node id="TaggedText">
											<attribute id="HasTagRule" type="bool" value="True" />
											<children>
												<node id="TagTexts">
													<children>
														<node id="TagText">
															<!--...Ok so, this is actually the same tagged text as before: 'Now, where did I hear that?' This means the audio file will be...exactly the same!
															
															That's because there's another use for custom sequences:
															
															Since they allow you to add new entries to the dialog timeline file, without having to make new dialog tree branches, I'm using these custom sequences to test for whether Durge is speaking to him, and give them a different expression during the line.
															
															Durge spoilers ahead, but I was actually planning on testing for whether you'd killed Alfira, and have Durge react differently to the song based on that. But I couldn't find instances of the game testing for anything but tags in custom sequences, so, hm. Will have to experiment more. This still works as a demonstration, though!
															
															...Also, let's assume Jason genuinely doesn't remember where he heard Alfira's song for this demo. Or that he doesn't know she's dead, if she is. This probably wouldn't be a very in-character reaction otherwise...-->
															<attribute id="TagText" type="TranslatedFSString" value="" handle="h1a12158b1f77436dbc297a71d61ed85cb636" arguments="0" />
															<attribute id="LineId" type="guid" value="5789187f-66e0-48d6-817b-4e11de6a1f2a" />
															<!--This will be used to identify the line that's Not testing for Durge in the timeline file.-->
															<attribute id="CustomSequenceId" type="guid" value="5789187f-66e0-48d6-817b-4e11de6a1f2a" />
															<attribute id="stub" type="bool" value="True" />
														</node>
													</children>
												</node>
												<!--There aren't any rules being tested for here!-->
												<node id="RuleGroup">
													<attribute id="TagCombineOp" type="uint8" value="0" />
													<children>
														<node id="Rules" />
													</children>
												</node>
											</children>
										</node>
									</children>
								</node>
							</children>
						</node>	  


						<node id="node" key="UUID">
							<attribute id="constructor" type="FixedString" value="TagQuestion" />
							<attribute id="UUID" type="FixedString" value="64350cc1-39b1-4c44-a705-90a0ff4eff80" />
