	<version major="3" minor="2" revision="0" build="0" lslib_meta="v1,bswap_guids" />
	<region id="VoiceMetaData">
		<node id="VoiceMetaData">
			<children>
				<node id="VoiceSpeakerMetaData">
					<!--This UUID tells the game which character the voicebank is for! Put their Global/RootTemplate UUID here. The voicebank file name will be this same UUID without the hyphens.-->
					<attribute id="MapKey" type="FixedString" value="1323c4b6-92f7-4fda-8bad-6a96b8ddbc73" />
					<children>
						<node id="MapValue">
							<children>
								<!--It's you! The mighty defenders of this little grove. (I recommend putting comments before each line so you know what they are)-->
								<node id="VoiceTextMetaData">
									<!--Put the text handle from your DialogsBinary and Localization files here!-->
									<attribute id="MapKey" type="FixedString" value="h3c280632737c454b9f1bac7cef87a669201d" />
									<children>
										<node id="MapValue">
											<!--The compression type for your .wem file. Most of the time, you'll want to match the VORBIS compression type the game uses.-->
											<attribute id="Codec" type="FixedString" value="VORBIS" />
											<!--Length of the audio file.-->
											<attribute id="Length" type="float" value="4.053" />
											<!--Type of voice line! There's also different priority settings for ambient dialogue in the overworld, party banter, point and click lines, etc. Try checking existing character voicebanks for examples! This is for regular conversation dialog.-->
											<attribute id="Priority" type="FixedString" value="P1_StoryDialog" />
											<!--The .wem audio file name. This will be a v followed by the character's UUID minus the hyphens, and then the text handle listed above. Lipysnc and dialog animations will have this same file name, but the lipsyncing will have an FX_ prefix at the start, and dialog animations will have an MC_ prefix.-->
											<attribute id="Source" type="FixedString" value="v1323c4b692f74fda8bad6a96b8ddbc73_h3c280632737c454b9f1bac7cef87a669201d.wem" />
										</node>
									</children>
								</node>

                                <!--The rest of the file is just going to fill out his lines. The only notes from here on out are the tagged texts, to help me remember which line is which!-->

								<!--There's not many who would stick their necks out for others like that.-->
								<node id="VoiceTextMetaData">
									<attribute id="MapKey" type="FixedString" value="h6f24a6cdedb2436d9dd8bb4b1ff6462ed0b0" />
									<children>
										<node id="MapValue">
